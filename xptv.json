  "getTracks": function(ext) {
    ext = argsify(ext);
    const id = ext.id || '';
    if (!id) return { "list": [] };
    
    // 从 detail 页获取分集
    const html = fetchHtml("https://huangguoai.com/detail/" + id + "/");
    const tracks = [];
    const gridM = html.match(/<div\s+class="[^"]*\bhg-web-detail__ep-grid\b[^"]*"[^>]*>([\s\S]*?)<\/div>/);
    if (gridM) {
      const are = /<a\b[^>]*>[\s\S]*?<\/a>/g;
      let m;
      while ((m = are.exec(gridM[1])) !== null) {
        const tag = m[0];
        const hrefM = tag.match(/href="([^"]+)"/);
        if (!hrefM) continue;
        const href = hrefM[1];
        const eidM = tag.match(/data-ep-id="([^"]*)"/);
        const eid = eidM ? eidM[1] : '';
        const name = eid ? "第" + eid + "集" : stripTags(tag);
        tracks.push({ "name": name, "ext": { "url": fix(href), "ep": eid } });
      }
    }
    if (!tracks.length) {
      const playM = html.match(/<a\b[^>]*class="[^"]*\bhg-web-detail__play\b[^"]*"[^>]*href="([^"]+)"/);
      if (playM) {
        tracks.push({ "name": "第1集", "ext": { "url": fix(playM[1]), "ep": "" } });
      }
    }
    if (!tracks.length) return { "list": [] };
    return { "title": "黄果短剧", "tracks": tracks };
  },
  
  "getPlayinfo": function(ext) {
    ext = argsify(ext);
    const url = ext.url || '';
    const ep = String(ext.ep || '1');
    if (!url) return { "urls": [] };
    
    const html = fetchHtml(url);
    let play = '';
    const m = html.match(/id="videoInitialData"[^>]*>([\s\S]*?)<\/script>/);
    if (m) {
      try {
        const data = JSON.parse(m[1]);
        const srcs = (data && data.epPlaySrcs) || {};
        play = srcs[ep] || (data && data.videoSrc) || '';
      } catch (e) {}
    }
    if (play) {
      play = play.replace(/\\u0026/g, '&');
      if (play.indexOf('http') !== 0) {
        const mm = play.match(/(https?:\/\/[^\s"']+)/);
        play = mm ? mm[1] : '';
      }
    }
    if (!play) return { "urls": [] };
    return {
      "urls": [play],
      "headers": [{ "User-Agent": "Mozilla/5.0", "Referer": "https://huangguoai.com/" }]
    };
  },
  
  "search": function(ext) {
    ext = argsify(ext);
    const kw = String(ext.text || ext.wd || '').trim();
    if (!kw) return { "list": [], "page": 1 };
    
    const html = fetchHtml("https://huangguoai.com/search/video/" + encodeURIComponent(kw) + "/");
    return { "list": [], "page": 1 };
  }
}

// 辅助函数
function argsify(ext) {
  if (typeof ext === 'string') return { "id": ext };
  return ext || {};
}

function stripTags(s) {
  return String(s || '')
    .replace(/<[^>]*>/g, '')
    .trim();
}

function fix(u) {
  if (!u) return '';
  if (u.indexOf('//') === 0) return 'https:' + u;
  if (u.indexOf('/') === 0) return 'https://huangguoai.com' + u;
  return u;
}